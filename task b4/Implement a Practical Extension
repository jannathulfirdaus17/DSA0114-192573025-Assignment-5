#include <iostream>
#include <string>
#include <vector>
#include <memory>
#include <algorithm>
#include <iomanip>
#include <stdexcept>
using namespace std;
// Existing Bill hierarchy
class Bill {
protected:
    string patient;
public:
    explicit Bill(const string& p) : patient(p) {}
    virtual ~Bill() = default;
    virtual double total() const = 0;
    virtual string type() const = 0;
    void print() const {
        cout << type() << " " << patient
             << ": " << total() << '\n';
    }
};
class OutPatient : public Bill {
    double consultation, tests;
public:
    OutPatient(const string& p, double c, double t)
        : Bill(p), consultation(c), tests(t) {}
    double total() const override {
        return consultation + tests;
    }
    string type() const override {
        return "OP";
    }
};
class InPatient : public Bill {
    int days;
    double perDay, surgery;
public:
    InPatient(const string& p, int d, double rate, double s)
        : Bill(p), days(d), perDay(rate), surgery(s) {}
    double total() const override {
        return days * perDay + surgery;
    }
    string type() const override {
        return "IP";
    }
};
// New bill type - no existing class modified
class EmergencyBill : public Bill {
    double emergencyFee, treatment;
public:
    EmergencyBill(const string& p, double fee, double cost)
        : Bill(p), emergencyFee(fee), treatment(cost) {}
    double total() const override {
        return emergencyFee + treatment;
    }
    string type() const override {
        return "Emergency";
    }
};
// Existing Payer hierarchy
class Payer {
public:
    virtual ~Payer() = default;
    virtual double amountCovered(const Bill& b) const = 0;
};
class SelfPay : public Payer {
public:
    double amountCovered(const Bill& b) const override {
        return b.total();
    }
};
class Insurance : public Payer {
    double coverLimit, coPayment;
public:
    Insurance(double limit, double percentage)
        : coverLimit(limit), coPayment(percentage) {}
    double amountCovered(const Bill& b) const override {
        double eligible = min(b.total(), coverLimit);
        return eligible * (1.0 - coPayment / 100.0);
    }
};
class GovernmentScheme : public Payer {
    double packageRate;
public:
    explicit GovernmentScheme(double rate)
        : packageRate(rate) {}

    double amountCovered(const Bill&) const override {
        return packageRate;
    }
};
// New payer - no existing class modified
class CharityFund : public Payer {
    double percentage;
public:
    explicit CharityFund(double p) : percentage(p) {}
    double amountCovered(const Bill& b) const override {
        return b.total() * percentage / 100.0;
    }
};
int main() {
    cout << fixed << setprecision(2);
    vector<unique_ptr<Bill>> bills;
    bills.push_back(
        make_unique<OutPatient>("Ravi", 500, 1200));
    bills.push_back(
        make_unique<InPatient>("Meena", 3, 2500, 40000));
    // New emergency bill
    bills.push_back(
        make_unique<EmergencyBill>("Arun", 5000, 15000));
    vector<unique_ptr<Payer>> payers;
    payers.push_back(make_unique<SelfPay>());
    payers.push_back(make_unique<Insurance>(50000, 20));
    payers.push_back(make_unique<GovernmentScheme>(30000));
    // New charity payer
    payers.push_back(make_unique<CharityFund>(50));
    cout << "EXTENDED BILL DETAILS\n";
    double grandTotal = 0;
    for (const auto& b : bills) {
        b->print();
        grandTotal += b->total();
    }
    cout << "Grand Total: " << grandTotal << '\n';
    cout << "\nPAYER DETAILS\n";
    for (size_t i = 0; i < payers.size(); i++) {
        cout << "\nPayer " << i + 1 << ":\n";
        for (const auto& b : bills) {
            cout << b->type() << " covered amount: "
                 << payers[i]->amountCovered(*b) << '\n';
        }
    }
    cout << "\nAll bills and payers processed successfully\n";
    return 0;
}
